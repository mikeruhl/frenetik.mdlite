{
  "name": "mdlite",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .js",
    "lint:fix": "eslint src --ext .js --fix",
    "lint:md": "markdownlint \"**/*.md\" --ignore node_modules --ignore target",
    "lint:md:fix": "markdownlint \"**/*.md\" --ignore node_modules --ignore target --fix",
    "format": "prettier --write \"**/*.{js,json,yml,yaml,md}\"",
    "format:check": "prettier --check \"**/*.{js,json,yml,yaml,md}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/cli": "^2.12.2",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "markdownlint-cli": "^0.49.1",
    "prettier": "^3.9.10",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@tauri-apps/plugin-cli": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.2",
    "@tauri-apps/plugin-opener": "^2.7.1",
    "@tauri-apps/plugin-store": "^2.5.0",
    "d3": "^7.9.0",
    "dompurify": "^3.4.17",
    "gemoji": "^8.1.0",
    "github-markdown-css": "^5.9.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0",
    "marked": "^18.1.1",
    "marked-alert": "^2.1.2",
    "marked-emoji": "^3.0.0",
    "marked-footnote": "^1.4.0",
    "marked-highlight": "^2.2.4",
    "marked-katex-extension": "^5.1.13",
    "mermaid": "^12.2.0",
    "vega": "^6.4.0",
    "vega-interpreter": "^2.3.2",
    "vega-lite": "^6.5.0"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.md": [
      "markdownlint --fix --ignore node_modules --ignore target",
      "prettier --write"
    ],
    "*.{json,yml,yaml}": [
      "prettier --write"
    ]
  }
}
