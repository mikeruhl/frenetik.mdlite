{
  "name": "mdlite",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "tauri": "tauri",
    "lint": "eslint src --ext .js",
    "lint:fix": "eslint src --ext .js --fix",
    "lint:md": "markdownlint \"**/*.md\" --ignore node_modules --ignore target",
    "lint:md:fix": "markdownlint \"**/*.md\" --ignore node_modules --ignore target --fix",
    "format": "prettier --write \"**/*.{js,json,yml,yaml,md}\"",
    "format:check": "prettier --check \"**/*.{js,json,yml,yaml,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/cli": "^2",
    "eslint": "^9.20.0",
    "markdownlint-cli": "^0.43.0",
    "prettier": "^3.4.2",
    "vite": "^8.0.8"
  },
  "dependencies": {
    "@tauri-apps/plugin-cli": "^2.4.1",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "dompurify": "^3.3.3",
    "github-markdown-css": "^5.9.0",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.0",
    "marked-highlight": "^2.2.4",
    "mermaid": "^11.14.0"
  }
}
