{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mdlite",
  "version": "0.1.0",
  "identifier": "com.frenetik.mdlite",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "mdlite",
        "width": 900,
        "height": 700,
        "minWidth": 620,
        "minHeight": 300
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src * data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "cli": {
      "description": "Lightweight markdown previewer",
      "args": [
        {
          "name": "path",
          "index": 1,
          "takesValue": true,
          "required": false,
          "description": "Path to a markdown file or folder to preview"
        }
      ]
    }
  }
}
